NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wingsfin

MARKET_TIMEZONE=Asia/Dhaka
MARKET_OPEN_TIME=10:00
MARKET_CLOSE_TIME=14:30
DEFAULT_INDEX_ID=DSEX
DEFAULT_STOCK_TRADE_CODE=GP
INDEX_YESTERDAY_CLOSE=5200
STOCK_YESTERDAY_CLOSE=238.88

SIMULATOR_ENABLED=true
SIMULATOR_MIN_INTERVAL_MS=300
SIMULATOR_MAX_INTERVAL_MS=3000
CORS_ORIGIN=http://localhost:5173

# Optional seed controls (used by `npm run seed`). Defaults: today's date in
# MARKET_TIMEZONE, seeded from MARKET_OPEN_TIME up to the current market minute,
# capped at MARKET_CLOSE_TIME.
# SEED_SESSION_DATE=2026-06-07
# SEED_UNTIL_TIME=11:30
