{
  "name": "backend",
  "version": "0.0.0",
  "scripts": {
    "build": "npx prisma generate && tsc --project tsconfig.prod.json",
    "dev": "cross-env DOTENV_CONFIG_PATH=./.env ts-node -r dotenv/config -r tsconfig-paths/register ./src/main.ts",
    "dev:watch": "nodemon --exec \"npm run dev\" --watch ./src --watch ./prisma --ext .ts,.prisma",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "cross-env DOTENV_CONFIG_PATH=./.env node -r dotenv/config -r module-alias/register ./dist/seed.runner.js",
    "start": "cross-env DOTENV_CONFIG_PATH=./.env node -r dotenv/config -r module-alias/register ./dist/main.js",
    "test": "cross-env NODE_ENV=test vitest",
    "type-check": "tsc -b --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "_moduleAliases": {
    "@src": "dist"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "luxon": "^3.7.2",
    "module-alias": "^2.3.4",
    "morgan": "^1.11.0",
    "pino": "^9.8.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.40",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/luxon": "^3.7.1",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.0.1",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
